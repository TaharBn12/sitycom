SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im5jZ3VqeHJvY2V0YW1obnZ3dW1wIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzc3NjQ0MDgsImV4cCI6MjA5MzM0MDQwOH0.pztE9-h7SNfzYgRaZnsOw0-YsQTUjoTG9-ERiXdfpXM

# منفذ الخادم
PORT=3000

# (اختياري) مستخدم لوحة التحكم الأول — يُنشأ عند أول تشغيل فقط إذا مُلئ الحقلان.
# إذا تركتهما فارغين، أنشئ أول حساب من الصفحة /register.html (يصبح تلقائيًا مديرًا).
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ── Ecotrack ────────────────────────────────────────────────
# الرابط الأساسي لحسابك عند شركة التوصيل (كل شركة لها نطاقها):
#   https://votre-societe.ecotrack.dz   |   https://platform.dhd-dz.com   ...
# اتركه فارغاً للعمل بالبيانات التجريبية (Mock) إلى حين إدخاله من لوحة التحكم
ECOTRACK_BASE_URL=https://platform.dhd-dz.com

# التوكن الخاص بك (من حساب Ecotrack ← API)
ECOTRACK_API_TOKEN=

# طريقة الإرسال: both | bearer | query
ECOTRACK_AUTH_MODE=both

# تشغيل وضع البيانات التجريبية يدوياً: 1 = دائماً mock (للعرض)
ECOTRACK_MOCK=0

# مهلة الاتصال بالـ API (ملي ثانية)
ECOTRACK_TIMEOUT=20000

