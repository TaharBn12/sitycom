{
  "name": "sitycom",
  "version": "1.0.0",
  "private": true,
  "description": "Sitycom — منصة تجارة إلكترونية جزائرية مع ربط كامل بـ Ecotrack API (21 endpoint)",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "reset-db": "node server/scripts/reset-db.js",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "cf:check": "wrangler deploy --dry-run --outdir .wrangler/dry",
    "cf:secrets": "node scripts/cf-secrets.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "express": "^5.2.1"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "license": "MIT",
  "devDependencies": {
    "wrangler": "^4.133.0"
  }
}
